# Используется сейчас: внешний порт Compose. make run всегда использует 8080.
GATEWAY_PORT=8080
SANDBOX_MANAGER_PORT=8081

# Параметры полного сервера из шаблона курса; пока не используются.
# Реальные лимиты учебного сандбокса v0: services/sandbox-manager/config.toml.
# Ключ должен передаваться только в llm-proxy, не во все сервисы через env_file.
LLM_PROVIDER_URL=
LLM_API_KEY=
CLIENT_TOKENS=
SANDBOX_CPU=1
SANDBOX_MEMORY=1g
SANDBOX_PIDS=256
SANDBOX_DISK=2g
SANDBOX_EXEC_TIMEOUT_S=120
