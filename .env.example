# Используется сейчас: внешний порт Compose. make run всегда использует 8080.
GATEWAY_PORT=8080
SANDBOX_MANAGER_PORT=8081

# Используется LLM-прокси; пустой ключ допустим для запуска, но не для задач с реальной моделью.
# Реальные лимиты учебного сандбокса v0: services/sandbox-manager/config.toml.
# Ключ должен передаваться только в llm-proxy, не во все сервисы через env_file.
LLM_PROVIDER_URL=https://inference.airi.net
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
CLIENT_TOKENS=local-dev-token

# Параметры шаблона ниже ещё не подключены; действующие лимиты — в config.toml сервисов.
SANDBOX_CPU=1
SANDBOX_MEMORY=1g
SANDBOX_PIDS=256
SANDBOX_DISK=2g
SANDBOX_EXEC_TIMEOUT_S=120
