      "required": [
        "content",
        "sha256"
      ],
      "title": "FileData",
      "type": "object"
    },
    "FixtureSession": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "0",
          "title": "Version",
          "type": "string"
        },
        "type": {
