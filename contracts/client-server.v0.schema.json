        "pending_operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Operation Id"
        },
        "result": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cancelled": "#/$defs/Cancelled",
                  "error": "#/$defs/Failed",
                  "ok": "#/$defs/Success"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Success"
                },
                {
                  "$ref": "#/$defs/Failed"
                },
                {
                  "$ref": "#/$defs/Cancelled"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "version",
        "type",
        "session_id",
        "run_id",
        "state"
