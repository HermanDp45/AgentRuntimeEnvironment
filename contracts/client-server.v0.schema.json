        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "waiting_approval",
            "finished"
