      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(missing|[0-9a-f]{64})$",
          "title": "Sha256",
          "type": "string"
        }
