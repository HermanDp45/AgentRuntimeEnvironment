          "title": "Type",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "files": {
          "maxProperties": 128,
          "patternProperties": {
            "^(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*(?:^|/)\\._are_)[^/\\\\\\x00]+(?:/[^/\\\\\\x00]+)*$": {
              "maxLength": 65536,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 512,
            "minLength": 1
          },
          "title": "Files",
          "type": "object"
        },
        "read_only": {
          "default": false,
